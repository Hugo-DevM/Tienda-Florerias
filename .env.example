# GitHub - Para leer/escribir products.json en tu repositorio
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
GITHUB_OWNER=tu_usuario_github
GITHUB_REPO=nombre_del_repo

# Dashboard - Contraseña para acceder al panel de administración
DASHBOARD_PASSWORD=paswords

# WhatsApp - Número con código de país, sin + ni espacios (ej: 5215512345678)
NEXT_PUBLIC_WA_NUMBER=5215512345678

# Cloudinary - Para subir imágenes de productos
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxx
